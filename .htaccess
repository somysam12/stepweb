Options -Indexes
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8

# Block sensitive folders
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^app/ - [F,L]
  RewriteRule ^writable/ - [F,L]
  # Extensionless key-verification endpoint: /validbool → validbool.php
  RewriteRule ^validbool/?$ validbool.php [L,QSA]
  # Extensionless secure endpoints
  RewriteRule ^secure/unlock/?$ secure/unlock.php [L,QSA]
  RewriteRule ^secure/lib/?$    secure/lib.php    [L,QSA]
</IfModule>

# Block direct PHP access in writable/uploads
<FilesMatch "^\.env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# PHP settings — raised so lib (.so up to 50MB) and APK (up to 200MB) uploads work
<IfModule mod_php7.c>
  php_value upload_max_filesize 210M
  php_value post_max_size 220M
  php_value max_execution_time 300
  php_value max_input_time 300
  php_value memory_limit 512M
  php_flag expose_php off
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 210M
  php_value post_max_size 220M
  php_value max_execution_time 300
  php_value max_input_time 300
  php_value memory_limit 512M
  php_flag expose_php off
</IfModule>
